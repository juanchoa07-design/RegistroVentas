rules_version = '2';

// Copiá este contenido en Firebase Console > Firestore Database > Reglas.
// Solo permite leer/escribir a clientes autenticados (autenticación anónima,
// que la app activa sola, sin pedir usuario/contraseña).
service cloud.firestore {
  match /databases/{database}/documents {
    match /jornadas/{jornadaId} {
      allow read, write: if request.auth != null;

      match /ventas/{ventaId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
